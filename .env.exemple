# Configurações da aplicação
APP_NAME=Meu Projeto
APP_ENV=development
DEBUG=True

# Configurações do PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=meu_banco
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Conexão SQLAlchemy
DATABASE_URL=postgresql+psycopg://seu_usuario:sua_senha@localhost:5432/meu_banco

# configuração JWT 
jwt_secret_key=string longa e aleatoria