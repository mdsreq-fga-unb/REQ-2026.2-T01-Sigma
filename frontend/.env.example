# Copie para .env.local e ajuste conforme o ambiente.

# --- Opção 1: mock local (padrão em `npm run dev`) ---
# NEXT_PUBLIC_API_URL=/api/mock
# SIGMA_API_MOCK=true

# --- Opção 2: backend FastAPI real ---
# As requisições para /api/backend/* são repassadas ao BACKEND_URL (ver next.config.ts).
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_URL=http://localhost:8001
SIGMA_API_MOCK=false
