# URL base da API consumida pelo cliente (browser).
# Modo mock: use "/api/mock" (padrão em .env.development) para servir dados fictícios
# das rotas em src/app/api/mock — não precisa de backend nem de Docker.
# Modo backend real (UC04 fichas/termos integrados): use "/api/backend".
NEXT_PUBLIC_API_URL=/api/mock

# Destino do rewrite quando NEXT_PUBLIC_API_URL=/api/backend.
# O navegador fala com o Next (/api/backend/*, mesma origem) e o servidor Next
# encaminha para este endereço (o header X-Renewed-Token é repassado).
# Docker Compose (serviço `frontend` chamando `backend` na rede interna): http://backend:8000
# Desenvolvimento local com `uvicorn` rodando no host (porta padrão do compose exposta): http://localhost:8001
# BACKEND_URL=http://backend:8000

# Desliga o mock (rotas /api/mock retornam 503) quando estiver usando o backend real.
SIGMA_API_MOCK=true
# Para rodar contra o backend real, ajuste também:
# NEXT_PUBLIC_API_URL=/api/backend
# BACKEND_URL=http://localhost:8001
# SIGMA_API_MOCK=false